{
  "name": "gmaps-crm-pro",
  "version": "0.1.0",
  "description": "GMaps CRM Pro - Global business finder with built-in sales CRM",
  "author": {
    "name": "99apps.id",
    "email": "support@99apps.id",
    "url": "https://99apps.id"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node --test test/*.test.js",
    "gen:license": "node tools/gen-license.js",
    "gen:icon": "node tools/build-icon.js",
    "electron": "electron .",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "dist:all": "electron-builder -mwl"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "id.ninenineapps.gmapscrmpro",
    "productName": "GMaps CRM Pro",
    "copyright": "Copyright (c) 99apps.id",
    "directories": {
      "output": "release"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "package.json",
      "server.js",
      "lib/catalog.js",
      "lib/crm.js",
      "lib/excel.js",
      "lib/xlsx.js",
      "lib/license.js",
      "lib/payment.js",
      "lib/scrape-runner.js",
      "public/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "electron/protocol.cjs",
      "electron/integrity-check.cjs",
      "electron/assets/icon.png",
      "electron/assets/icon.ico"
    ],
    "win": {
      "icon": "electron/assets/icon.ico",
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "GMaps CRM Pro"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "electron/assets/icon.png",
      "category": "public.app-category.business"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "electron/assets/icon.png",
      "category": "Office",
      "maintainer": "99apps.id <support@99apps.id>",
      "vendor": "99apps.id",
      "description": "GMaps CRM Pro - Global business finder with built-in sales CRM",
      "desktop": {
        "Name": "GMaps CRM Pro",
        "Comment": "Global business finder with built-in sales CRM",
        "Categories": "Office;Business;"
      }
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    }
  },
  "allowScripts": {
    "electron@34.5.8": true
  }
}
